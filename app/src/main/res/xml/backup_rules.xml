<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-backup rules for Android 11 and below (API 30-). Mirrors data_extraction_rules.xml:
  the photo directory is excluded so a large photo library cannot consume the 25 MB backup
  quota and cause the database backup to be rejected as well.

  Valid domains are: root, file, database, sharedpref, external. Cache directories are never
  backed up, so they need no entry.
-->
<full-backup-content>
    <exclude domain="file" path="timed_note_photos" />
</full-backup-content>
